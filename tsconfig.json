{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "lib/_disabled-old-data-engine/**",
    "lib/diagnostics/**",
    "lib/importers/**",
    "lib/ipo-engine-lite/**",
    "lib/providers/**",
    "test/**",
    "test-*.ts",
    "test-parser.ts",
    "scratch/**",
    "scratch.ts",
    "scratch.js",
    "scripts/test-*",
    "vitest.config.ts"
  ]
}
