{
  "functions": {
    "app/api/sync-ipos/route.ts": {
      "maxDuration": 60
    },
    "app/api/sync-subscription/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/update-listing-performance/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-ipos",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync-subscription",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/update-listing-performance",
      "schedule": "30 11 * * 1-5"
    }
  ]
}
