import { describe, it, expect, vi, beforeEach } from "vitest";
import { runIPODetailSync } from "../../lib/_disabled-old-data-engine/sync/runIPODetailSync";
import { supabaseAdmin } from "../../lib/supabase";

vi.mock("../../lib/supabase", () => ({
  supabaseAdmin: {
    from: vi.fn()
  }
}));

describe("runIPODetailSync", () => {
  beforeEach(() => {
    vi.resetAllMocks();
  });

  it("skips IPO Guru detail URLs because parser is not implemented", async () => {
    // Mock ipos query
    const iposSelect = vi.fn().mockResolvedValue({ data: [{ id: "1", name: "Test IPO", slug: "test-ipo" }], error: null });

    // Mock sources query
    const sourcesSelect = vi.fn().mockResolvedValue({
      data: [
        {
          ipo_id: "1",
          source_name: "IPO Guru",
          source_url: "https://ipoguru.com/test",
          provider: "IPO Guru"
        }
      ],
      error: null
    });

    const mockFrom = vi.fn((table) => {
      if (table === "ipos") {
        return { select: () => ({ eq: () => Promise.resolve({ data: [{ id: "1", name: "Test", slug: "test" }], error: null }), then: (cb: any) => iposSelect().then(cb) }) };
      }
      if (table === "ipo_source_documents") {
        return {
          select: () => ({
            eq: () => ({
              in: () => ({
                order: () => ({
                  order: () => sourcesSelect()
                })
              })
            })
          })
        };
      }
      return { insert: vi.fn().mockResolvedValue({}) };
    });

    (supabaseAdmin.from as any).mockImplementation(mockFrom);

    const result = await runIPODetailSync({ triggeredBy: "system", dryRun: true });

    expect(result.skipped.length).toBe(1);
    expect(result.skipped[0].reason).toContain("Unsupported source for full detail import");
  });
});
